# Copy to .env.local and fill in. Never commit real values.

# Upstash Redis (the only datastore): console.upstash.com → your database → REST API
# (Connecting Upstash from Vercel's Storage tab sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth.js: generate with `npx auth secret` (min 32 chars)
AUTH_SECRET=
# Resend API key for magic-link email. Optional in development: without it the link is printed to the server console.
AUTH_RESEND_KEY=
RESEND_FROM="Sheetfolio <no-reply@yourdomain>"

# Image uploads (Day 2): Vercel Blob token, or set CLOUDINARY_URL instead
BLOB_READ_WRITE_TOKEN=

# Public base URL, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Comma-separated emails that get the admin role at onboarding
ADMIN_EMAILS=
