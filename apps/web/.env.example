# Copy to .env.local and fill in. Never commit real values.

# Upstash Redis (the only datastore): console.upstash.com → your database → REST API
# (Connecting Upstash from Vercel's Storage tab sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth.js: generate with `npx auth secret` (min 32 chars)
AUTH_SECRET=
# Resend API key for magic-link email. Optional in development: without it the link is printed to the server console.
AUTH_RESEND_KEY=
RESEND_FROM="Sheetfolio <no-reply@yourdomain>"

# Image and PDF uploads: Cloudinary dashboard → Settings → API keys → "API environment variable"
# (looks like cloudinary://<api_key>:<api_secret>@<cloud_name>). Also read by next.config.ts to allow the images.
CLOUDINARY_URL=

# Address shown on the privacy policy for data requests and support
SUPPORT_EMAIL=

# Postgres (Neon). Only needed once a store below leaves "redis". Vercel's Neon integration sets DATABASE_URL for you.
DATABASE_URL=
# Where each kind of data lives while it moves from Redis to Postgres: redis (default) | dual | pg-first | postgres.
# See lib/store/mode.ts. Leave blank to stay on Redis.
ACCOUNTS_STORE=
LEADS_STORE=
SITES_STORE=

# Secret for the daily job that copies view and download totals to Postgres (vercel.json). 32+ random characters.
CRON_SECRET=

# Public base URL, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Comma-separated emails that get the admin role at onboarding
ADMIN_EMAILS=

# Project website previews: screenshot service used when a site has no social image. `{url}` is replaced by the
# encoded link. Leave blank to use Microlink's free tier.
SCREENSHOT_URL_TEMPLATE=
